#include <winver.h>

// the lowest ID is the DLL's first icon: the input method's own (register_profile)
100 ICON "icon_profile.ico"
101 ICON "icon.ico"
102 ICON "icon_en.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404B0"
        BEGIN
            VALUE "FileDescription", "DualityIME input method"
            VALUE "ProductName", "DualityIME"
            VALUE "FileVersion", "2.0.0"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
